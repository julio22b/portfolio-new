---
import { Icon } from 'astro-icon/components';
import { getData } from '../lib/getData';
import localTechData from '../data/tech.json';

const techData = await getData('tech', localTechData);
const { categories } = techData;
---

<section id="tech" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="tech-header flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> Tech Stack
        </h2>
        <p class="text-subtext font-body text-sm max-w-md">
          Breakdown of my technical skills, categorized by domain
        </p>
      </div>
    </div>

    <div class="space-y-10">
      {categories.map((category) => (
        <div class="space-y-3">
          <h3 class="text-maintext font-body text-[11px] uppercase tracking-[0.4em] ml-1">
            {category.title}
          </h3>
          
          <ul class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-5 sm:gap-8" role="list">
            {category.skills.map((skill) => (
              <li>
                <div class="skill-card opacity-0 group relative flex items-stretch min-h-14 rounded-xl bg-accent/5 border border-accent/15 hover:border-accent/40 hover:bg-accent/10 hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300">
                  
                  <div class="shrink-0 w-12 flex items-center justify-center rounded-l-xl bg-accent/15 transition-colors group-hover:bg-accent/20">
                    <Icon name={skill.icon} class="w-7 h-7 group-hover:scale-110 transition-transform" />
                  </div>
                  
                  <div class="flex items-center px-3 py-2 overflow-hidden w-full">
                    <span class="font-body text-maintext/90 text-[13px] leading-tight font-medium tracking-tight line-clamp-2">
                      {skill.name}
                    </span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Header Initial State */
  .tech-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Initial state of the card */
  .skill-card {
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shared Revealed state */
  .tech-header.reveal,
  .skill-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  import { setupScrollReveal } from '../utils/reveal';

  function init() {
    setupScrollReveal(
      [
        { selector: '.tech-header' },
        { selector: '.skill-card', stagger: 30 },
      ],
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>