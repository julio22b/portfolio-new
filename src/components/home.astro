---
import { Icon } from 'astro-icon/components';
import type localHomeData from '../data/home.json';

interface Props {
  data: typeof localHomeData;
}

const { data } = Astro.props;
const { name, intro, socials } = data;
---

<section id="home" class="flex items-center justify-center section-container md:pt-30 min-h-[80vh]">
  <div class="w-full max-w-7xl mx-auto px-2 sm:px-10 lg:pl-12 lg:pr-0 grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-x-12 xl:gap-x-16 gap-y-8 items-center text-center lg:text-left">

    <div class="lg:col-start-1 lg:row-start-1 lg:self-end">
      <div class="reveal-content" style="animation-delay: 100ms;">
        <p class="font-body font-light text-subtext leading-relaxed">
          Hello, I'm
        </p>
      </div>

      <div class="relative z-0 reveal-content" style="animation-delay: 200ms;">
        <h1 class="text-5xl md:text-7xl lg:text-6xl xl:text-7xl font-heading font-bold text-maintext tracking-tight">
          {name}
        </h1>
        <br>
        <p
          class="text-subtext font-body text-lg leading-relaxed"
          set:html={intro}
        />
      </div>
    </div>

    <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2 xl:-mr-8 reveal-content" style="animation-delay: 300ms;">
      <div class="relative">
        <video
          controls
          playsinline
          preload="none"
          poster="/intro_poster_A.jpg"
          class="w-full aspect-video rounded-2xl border border-accent/40 bg-black object-cover shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_25%,transparent)]"
          aria-label={`Intro video from ${name.trim()}`}
        >
          <source src="/intro_web_A_subs_720.mp4" type="video/mp4" />
        </video>
        <div class="absolute -z-10 inset-0 bg-accent rounded-2xl blur-[80px] opacity-15"></div>
      </div>
    </div>

    <div class="lg:col-start-1 lg:row-start-2 lg:self-start flex flex-col items-center lg:items-start">
      <div class="mb-4 reveal-content" style="animation-delay: 400ms;">
        <a
          href="/Julio-Bermudez-Senior-React-Engineer.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center justify-center px-10 py-2 bg-white/5 border border-white/10 rounded-full text-maintext font-body transition-all duration-300

                 border-accent/50 bg-accent/10 shadow-xl shadow-accent/20

                 md:border-accent/50 md:bg-accent/10 md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-xl md:hover:shadow-accent/30
                 hover:scale-105"
        >
          <div class="flex flex-col items-center justify-center text-center">
            <span class="tracking-wide text-sm md:text-base font-medium transition-transform duration-300 md:translate-y-2 md:group-hover:translate-y-0">
              View Resume
            </span>

            <span class="text-[10px] text-subtext font-light whitespace-nowrap transition-all duration-300
                         /* Mobile: Always visible */
                         opacity-100 translate-y-0
                         /* Desktop: Hidden until hover */
                         md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0">
              Downloads PDF file
            </span>
          </div>

          <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
        </a>
      </div>

      <div class="flex gap-6 mt-4 reveal-content" style="animation-delay: 500ms;">
        {socials.filter((social) => social.url && social.url !== "#" && social.url !== "").map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
          >
            <Icon
            name={social.icon}
            class="w-8 h-8 text-maintext group-hover:text-accent transition-colors duration-300"
          />

          <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
            {social.name}
          </span>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>
